      --arg default_url "$probe_default_url" \
      --arg default_method "$XRAY_PROBE_HTTP_METHOD" \
      --argjson default_timeout "$XRAY_PROBE_TIMEOUT_SECONDS" '
      def ascii_space:
        . == 9 or . == 10 or . == 11 or . == 12 or . == 13 or . == 32;
      def ascii_digit:
        . >= 48 and . <= 57;
      def numeric_text:
        type == "string" and length > 0 and (explode | all(.[]; ascii_digit));
      def decimal_text:
        type == "string" and
        (split(".") as $parts |
         (($parts | length) == 1 and ($parts[0] | numeric_text)) or
         (($parts | length) == 2 and all($parts[]; numeric_text)));
      def trim_left_space:
        if length > 0 and (.[0] | ascii_space) then .[1:] | trim_left_space else . end;
      def trim_space:
        explode | trim_left_space | reverse | trim_left_space | reverse | implode;
      def wait_duration:
        (if endswith("ms") then {amount:.[0:-2],unit:"ms"}
         elif endswith("s") then {amount:.[0:-1],unit:"s"}
         elif endswith("m") then {amount:.[0:-1],unit:"m"}
