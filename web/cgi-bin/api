    # подходить. Хранилище оперативное: переживать перезапуск контейнера
    # проверкам незачем.
    probe_store=$STATUS_DIR/$id.probes.json
    probe_store_tmp=$probe_store.tmp.$$
    probe_store_previous=$PROBE_TEMP_DIR/probes-previous.json
    if [ -s "$probe_store" ] && jq -e 'type == "object"' "$probe_store" >/dev/null 2>&1; then
      cp "$probe_store" "$probe_store_previous" 2>/dev/null || printf '{}\n' > "$probe_store_previous"
    else
      printf '{}\n' > "$probe_store_previous"
    fi
    if jq -n --slurpfile previous "$probe_store_previous" \
        --arg fingerprint "$probe_actual_fingerprint" --argjson delay "$probe_delay" \
        --arg method "$probe_method" --arg source "$probe_source_kind" --argjson at "$(date +%s)" '
        (($previous[0] // {}) | if type == "object" then . else {} end)
        + {($fingerprint): {delay_ms:$delay,method:$method,source:$source,at:$at}}
        | to_entries | sort_by(-.value.at)[0:64] | from_entries
      ' > "$probe_store_tmp" 2>/dev/null; then
      chmod 600 "$probe_store_tmp" 2>/dev/null || true
      mv "$probe_store_tmp" "$probe_store" 2>/dev/null || rm -f "$probe_store_tmp"
    else
      rm -f "$probe_store_tmp"
    fi
    probe_cleanup
    trap - 0 HUP INT TERM
    json_headers
    jq -n \
      --argjson index "$probe_index" --argjson reachable "$probe_reachable" --argjson delay "$probe_delay" \
      --argjson alive "$probe_alive" --argjson total "$probe_total" --arg method "$probe_method" --arg source "$probe_source_kind" \
      '{ok:true,index:$index,reachable:$reachable,delay_ms:$delay,alive:$alive,total:$total,method:$method,source:$source}'
    ;;
  probe-all)
    # Проверка всех конфигураций одним экземпляром ядра. Раньше панель гоняла
    # probe-config по очереди, поднимая отдельный Xray на каждую строку: на
    # восьми конфигурациях это восемь запусков подряд. burstObservatory умеет
    # опрашивать произвольное число outbound параллельно, поэтому все они
    # сводятся в один конфиг.
    #
    # dns, routing и geodata сюда не переносятся сознательно: burstObservatory
    # дозванивается через outbound напрямую, мимо маршрутизации, поэтому
    # правила с geosite/geoip только потребовали бы файлы geodata и аренду на
    # них, ничего не давая проверке. Имена серверов резолвит системный
    # резолвер контейнера.
    id=$(form_value profile_id); profile=$(profile_path "$id") || reply_error 'Invalid profile'; [ -f "$profile" ] || reply_error 'Profile not found'
    command -v nc >/dev/null 2>&1 || reply_error 'Health check is unavailable'
    command -v wget >/dev/null 2>&1 || reply_error 'Health check is unavailable'
    probe_lock || { probe_cleanup; reply_error 'Another health check is still running'; }
    umask 077
    probe_nonce=$(openssl rand -hex 8 2>/dev/null || printf '%s-%s' "$$" "$(date +%s)")
    PROBE_TEMP_DIR=$RUNTIME_DIR/probe.$probe_nonce
    mkdir -m 700 "$PROBE_TEMP_DIR" 2>/dev/null || { probe_cleanup; reply_error 'Could not prepare health check'; }
    trap 'probe_cleanup' 0
    trap 'exit 1' HUP INT TERM
    probe_source=$(profile_source "$id")
    probe_configs_meta=$PROBE_TEMP_DIR/configs.json
    probe_raw=$PROBE_TEMP_DIR/source.json
    probe_ready=0
    if lock_job "$id-selection"; then
      configs=$(profile_configs "$id" 2>/dev/null || true)
      if [ -s "$probe_source" ] && [ -s "$configs" ] &&
         jq -e 'type == "array" and length > 0' "$probe_source" >/dev/null 2>&1 &&
         cp "$probe_source" "$probe_raw" && cp "$configs" "$probe_configs_meta"; then
        probe_ready=1
      fi
      unlock_job "$id-selection"
    fi
    [ "$probe_ready" = 1 ] || reply_error 'Configurations are not ready'
    load_settings
    probe_default_url=$(b64_decode "$XRAY_PROBE_URL_B64")
    case "$probe_default_url" in
      http://*|https://*) case "$probe_default_url" in *[[:space:]]*) probe_default_url=https://www.gstatic.com/generate_204 ;; esac ;;
      *) probe_default_url=https://www.gstatic.com/generate_204 ;;
    esac
    [ "${#probe_default_url}" -le 2048 ] || probe_default_url=https://www.gstatic.com/generate_204
    probe_method=$XRAY_PROBE_HTTP_METHOD
    probe_wait_timeout=$XRAY_PROBE_TIMEOUT_SECONDS
    valid_number "$probe_wait_timeout" && [ "$probe_wait_timeout" -ge 1 ] && [ "$probe_wait_timeout" -le 120 ] || probe_wait_timeout=5
    probe_metrics_port=$(probe_port) || reply_error 'No local port is available for health check'
    probe_prefix=remnasub-all-$probe_nonce-
    probe_config=$PROBE_TEMP_DIR/config.json
    probe_plan=$PROBE_TEMP_DIR/plan.json
    if ! jq \
      --arg prefix "$probe_prefix" \
      --arg metrics_tag "${probe_prefix}metrics" \
      --arg metrics_listen "127.0.0.1:$probe_metrics_port" \
      --arg url "$probe_default_url" \
      --arg method "$probe_method" \
      --arg timeout "${probe_wait_timeout}s" '
      def proxy:
        type == "object" and
        ((.protocol? // "" | tostring | ascii_downcase) as $protocol |
          (["freedom","blackhole","dns","loopback"] | index($protocol)) == null);
      # Теги переписываются на c<конфигурация>-<позиция>: одинаковые теги в
      # разных элементах подписки — обычное дело, а в общем ядре они обязаны
      # быть уникальны. Ссылки цепочек переносятся по той же карте, иначе
      # dialerProxy и proxySettings укажут в пустоту.
      def retag($i; $outs):
        ([$outs | to_entries[] | {key: ((.value.tag // "") | tostring), value: ("c\($i)-\(.key)")}]
         | map(select(.key != "")) | from_entries) as $map |
        [$outs | to_entries[] | .key as $j | .value
          | .tag = "c\($i)-\($j)"
          | (if (.proxySettings?.tag? | type) == "string" and ($map[.proxySettings.tag] != null)
             then .proxySettings.tag = $map[.proxySettings.tag] else . end)
          | (if (.streamSettings?.sockopt?.dialerProxy? | type) == "string" and ($map[.streamSettings.sockopt.dialerProxy] != null)
             then .streamSettings.sockopt.dialerProxy = $map[.streamSettings.sockopt.dialerProxy] else . end)
          | (if (.sockopt?.dialerProxy? | type) == "string" and ($map[.sockopt.dialerProxy] != null)
             then .sockopt.dialerProxy = $map[.sockopt.dialerProxy] else . end)];
      [to_entries[]
       | .key as $i
       | select(.value | type == "object")
       | (retag($i; (.value.outbounds // []))) as $outs
       | {index: $i, outbounds: $outs,
          target: ([$outs | to_entries[] | select(.value | proxy) | .key] | first)}] as $configs |
      ($configs | map(select(.target != null) | {index, tag: ($prefix + (.index | tostring)), source: .outbounds[.target]})) as $targets |
      {plan: ($targets | map({index, tag})),
       config: {
         log: {loglevel: "error"},
         stats: {},
         inbounds: [],
         outbounds: (($configs | map(.outbounds) | add // []) + ($targets | map(.source + {tag}))),
         metrics: {tag: $metrics_tag, listen: $metrics_listen},
         burstObservatory: {subjectSelector: [$prefix],
                            pingConfig: {destination: $url, connectivity: "", interval: "1h",
                                         sampling: 1, timeout: $timeout, httpMethod: $method}}}}
    ' "$probe_raw" > "$PROBE_TEMP_DIR/assembled.json"; then
      reply_error 'Could not assemble health check configuration'
    fi
    jq -c '.plan' "$PROBE_TEMP_DIR/assembled.json" > "$probe_plan" || reply_error 'Could not assemble health check configuration'
    jq '.config' "$PROBE_TEMP_DIR/assembled.json" > "$probe_config" || reply_error 'Could not assemble health check configuration'
    probe_total=$(jq -r 'length' "$probe_plan" 2>/dev/null)
    valid_number "$probe_total" || reply_error 'Could not count configurations'
    [ "$probe_total" -ge 1 ] || reply_error 'No configuration has a proxy outbound to check'
    [ "$probe_total" -le 64 ] || reply_error 'Subscription has more than 64 configurations to check'
    if ! xray run -test -c "$probe_config" > "$PROBE_TEMP_DIR/xray.log" 2>&1; then
      reply_error 'Xray rejected health check configuration'
    fi
    xray run -c "$probe_config" > "$PROBE_TEMP_DIR/xray.log" 2>&1 &
    PROBE_XRAY_PID=$!
    probe_metrics=$PROBE_TEMP_DIR/metrics.json
    probe_metrics_tmp=$PROBE_TEMP_DIR/metrics.tmp
    probe_metrics_ready=0
    probe_deadline=$(( $(date +%s) + probe_wait_timeout + 10 ))
    while [ "$(date +%s)" -le "$probe_deadline" ]; do
      if wget -q -Y off -T 1 -O "$probe_metrics_tmp" "http://127.0.0.1:$probe_metrics_port/debug/vars" 2>/dev/null &&
         jq -e 'type == "object"' "$probe_metrics_tmp" >/dev/null 2>&1; then
        mv "$probe_metrics_tmp" "$probe_metrics"
        probe_metrics_ready=1
        probe_seen=$(jq -r --arg prefix "$probe_prefix" '((.observatory // {}) | to_entries | map(select(.key | startswith($prefix))) | length)' "$probe_metrics" 2>/dev/null)
        valid_number "$probe_seen" || probe_seen=0
        [ "$probe_seen" -lt "$probe_total" ] || break
      fi
      kill -0 "$PROBE_XRAY_PID" 2>/dev/null || break
      sleep 0.2
    done
    [ "$probe_metrics_ready" = 1 ] || reply_error 'Xray health check could not start'
    probe_results=$PROBE_TEMP_DIR/results.json
    jq -c --slurpfile plan "$probe_plan" --arg method "$probe_method" '
      (.observatory // {}) as $observed |
      [$plan[0][] |
        ($observed[.tag] // null) as $result |
        {index,
         delay_ms: (if ($result.alive? // false) and (($result.delay? | type) == "number") and ($result.delay >= 0)
                    then $result.delay else null end),
         method: $method, source: "burst"}]
    ' "$probe_metrics" > "$probe_results" 2>/dev/null || printf '[]\n' > "$probe_results"
    probe_store=$STATUS_DIR/$id.probes.json
    probe_store_tmp=$probe_store.tmp.$$
    probe_store_previous=$PROBE_TEMP_DIR/probes-previous.json
    if [ -s "$probe_store" ] && jq -e 'type == "object"' "$probe_store" >/dev/null 2>&1; then
      cp "$probe_store" "$probe_store_previous" 2>/dev/null || printf '{}\n' > "$probe_store_previous"
    else
      printf '{}\n' > "$probe_store_previous"
    fi
    if jq -n --slurpfile previous "$probe_store_previous" --slurpfile results "$probe_results" \
        --slurpfile meta "$probe_configs_meta" --argjson at "$(date +%s)" '
        ([$meta[0][]? | {key: (.index | tostring), value: .fingerprint}] | from_entries) as $fingerprints |
        (($previous[0] // {}) | if type == "object" then . else {} end) as $stored |
        reduce ($results[0][]?) as $result ($stored;
          ($fingerprints[$result.index | tostring]) as $fingerprint |
          if $fingerprint == null then . else
            . + {($fingerprint): {delay_ms: $result.delay_ms, method: $result.method, source: $result.source, at: $at}}
          end)
        | to_entries | sort_by(-.value.at)[0:64] | from_entries
      ' > "$probe_store_tmp" 2>/dev/null; then
      chmod 600 "$probe_store_tmp" 2>/dev/null || true
      mv "$probe_store_tmp" "$probe_store" 2>/dev/null || rm -f "$probe_store_tmp"
    else
      rm -f "$probe_store_tmp"
    fi
    probe_reply=$(jq -c '.' "$probe_results")
    probe_cleanup
    trap - 0 HUP INT TERM
    json_headers
    jq -n --argjson results "$probe_reply" --argjson total "$probe_total" \
      '{ok:true,total:$total,results:$results}'
    ;;
  select)
    id=$(form_value profile_id); profile=$(profile_path "$id") || reply_error 'Invalid profile'; [ -f "$profile" ] || reply_error 'Profile not found'
    state_lock || reply_error 'Could not lock container state'
    [ -f "$profile" ] || reply_error 'Profile not found'
    load_settings; ACTIVE_PROFILE_ID=$id
    write_state || reply_error 'Could not save active profile'
    state_unlock
    runtime_dir=$(profile_runtime_dir "$id")
    if [ -d "$runtime_dir" ] && [ -n "$(find "$runtime_dir" -maxdepth 1 -type f -name '*.json' -size +0c -print -quit 2>/dev/null)" ]; then
      [ "$RUN_ENABLED" = 1 ] && kill -HUP 1 2>/dev/null || true
    elif [ -s "$(profile_source "$id")" ]; then
      queue_job "$id" build || true
    elif [ -n "$(b64_decode "$(state_get "$profile" URL_B64)")" ]; then
      queue_job "$id" fetch || true
    fi
    json_headers; printf '{"ok":true}\n'
    ;;
  delete)
    id=$(form_value profile_id); state_lock || reply_error 'Could not lock container state'
    load_settings; [ "$id" != "$ACTIVE_PROFILE_ID" ] || reply_error 'Active profile cannot be deleted'
    valid_profile_id "$id" || reply_error 'Invalid profile'
    lock_job "$id-selection" || reply_error 'Could not lock profile configuration'
    if ! clear_profile_runtime "$id"; then
      unlock_job "$id-selection"
      reply_error 'Could not clear profile configuration'
    fi
    rm -f "$PROFILES_DIR/$id.conf" "$(profile_source "$id")" "$(profile_meta "$id")" "$STATUS_DIR/$id.conf" "$STATUS_DIR/$id.version" "$ERRORS_DIR/$id.txt" "$JOBS_DIR/$id.job" "$RUNTIME_DIR/$id.validation.log" "$(profile_active_pointer "$id")"
    rmdir "$(profile_versions_dir "$id")" 2>/dev/null || true
    unlock_job "$id-selection"
    state_unlock
    json_headers; printf '{"ok":true}\n'
    ;;
  start|stop)
    state_lock || reply_error 'Could not lock container state'
    load_settings
    if [ "$action" = start ]; then
      active_profile=$(profile_path "$ACTIVE_PROFILE_ID") || reply_error 'Invalid active profile'
      [ -f "$active_profile" ] || reply_error 'Active profile not found'
      active_url=$(b64_decode "$(state_get "$active_profile" URL_B64)")
      [ -n "$active_url" ] || reply_error 'Configure the subscription URL first'
      RUN_ENABLED=1
    else
      RUN_ENABLED=0
    fi
    write_state || reply_error 'Could not save container state'
    state_unlock; kill -HUP 1 2>/dev/null || true
    json_headers; printf '{"ok":true}\n'
    ;;
  hash)
    password=$(form_value password)
    [ "${#password}" -ge 8 ] && [ "${#password}" -le 128 ] || reply_error 'Password must contain 8..128 characters'
    password_result=$(password_hash "$password") || reply_error 'Could not generate password hash'
    password_digest=$(printf '%s\n' "$password_result" | head -n 1)
    password_algorithm=$(printf '%s\n' "$password_result" | tail -n 1)
    [ -n "$password_digest" ] || reply_error 'Could not generate password hash'
    json_headers; jq -n --arg hash "$password_digest" --arg algorithm "$password_algorithm" '{ok:true,hash:$hash,algorithm:$algorithm}'
    ;;
  save-settings)
    state_lock || reply_error 'Could not lock container state'
    load_settings
    old_global_headers=$GLOBAL_HEADERS_B64
    old_runtime_signature=$LISTENER_MODE:$REDIR_PORT:$TPROXY_PORT:$LOG_LEVEL:$XRAY_SNIFFING_ENABLED:$XRAY_SNIFFING_ROUTE_ONLY:$GEODATA_STORAGE:$XRAY_LOG_ERROR:$XRAY_LOG_ACCESS:$XRAY_LOG_DNS:$XRAY_LOG_MASK_ADDRESS
    LISTENER_MODE=$(form_value listener_mode); REDIR_PORT=$(form_value redir_port); TPROXY_PORT=$(form_value tproxy_port)
    LOG_LEVEL=$(form_value log_level)
    value=$(form_value xray_log_error); [ -z "$value" ] || XRAY_LOG_ERROR=$value
    value=$(form_value xray_log_access); [ -z "$value" ] || XRAY_LOG_ACCESS=$value
    XRAY_LOG_DNS=$(form_value xray_log_dns); XRAY_LOG_MASK_ADDRESS=$(form_value xray_log_mask_address)
    valid_log_sink XRAY_LOG_ERROR /dev/stderr
    valid_log_sink XRAY_LOG_ACCESS /dev/stdout
    case "$XRAY_LOG_DNS" in 1) ;; *) XRAY_LOG_DNS=0 ;; esac
    case "$XRAY_LOG_MASK_ADDRESS" in 1) ;; *) XRAY_LOG_MASK_ADDRESS=0 ;; esac
    NETWORK_QDISC=$(form_value network_qdisc); NETWORK_DISABLE_IPV6=$(form_value network_disable_ipv6); NETWORK_DISABLE_MULTICAST=$(form_value network_disable_multicast)
    global_headers_present=$(form_value global_headers_present)
    if [ "$global_headers_present" = 1 ]; then
      global_headers=$(form_value global_headers)
      valid_header_block "$global_headers" || reply_error 'Headers contain an invalid or duplicate name'
      GLOBAL_HEADERS_B64=$(b64_encode "$global_headers")
    fi
    value=$(form_value network_ct_established); [ -z "$value" ] || NETWORK_CT_ESTABLISHED=$value
    value=$(form_value network_ct_syn_sent); [ -z "$value" ] || NETWORK_CT_SYN_SENT=$value
    value=$(form_value network_ct_syn_recv); [ -z "$value" ] || NETWORK_CT_SYN_RECV=$value
    value=$(form_value network_ct_fin_wait); [ -z "$value" ] || NETWORK_CT_FIN_WAIT=$value
    value=$(form_value network_ct_close_wait); [ -z "$value" ] || NETWORK_CT_CLOSE_WAIT=$value
    value=$(form_value network_ct_last_ack); [ -z "$value" ] || NETWORK_CT_LAST_ACK=$value
    value=$(form_value network_ct_time_wait); [ -z "$value" ] || NETWORK_CT_TIME_WAIT=$value
    value=$(form_value network_ct_close); [ -z "$value" ] || NETWORK_CT_CLOSE=$value
    value=$(form_value network_ct_unacknowledged); [ -z "$value" ] || NETWORK_CT_UNACKNOWLEDGED=$value
    value=$(form_value network_ct_udp_stream); [ -z "$value" ] || NETWORK_CT_UDP_STREAM=$value
    value=$(form_value xray_sniffing_enabled); [ -z "$value" ] || XRAY_SNIFFING_ENABLED=$value
    value=$(form_value xray_sniffing_route_only); [ -z "$value" ] || XRAY_SNIFFING_ROUTE_ONLY=$value
    probe_url=$(form_value xray_probe_url)
    XRAY_PROBE_TIMEOUT_SECONDS=$(form_value xray_probe_timeout_seconds)
    XRAY_PROBE_HTTP_METHOD=$(form_value xray_probe_http_method)
    GEODATA_STORAGE=$(form_value geodata_storage)
    case "$LISTENER_MODE" in auto|tproxy|redir-tproxy|redir-tun) ;; *) reply_error 'Invalid listener mode' ;; esac
    valid_number "$REDIR_PORT" && [ "$REDIR_PORT" -ge 1 ] && [ "$REDIR_PORT" -le 65535 ] || reply_error 'Invalid REDIR port'
    valid_number "$TPROXY_PORT" && [ "$TPROXY_PORT" -ge 1 ] && [ "$TPROXY_PORT" -le 65535 ] || reply_error 'Invalid TPROXY port'
    [ "$REDIR_PORT" != "$TPROXY_PORT" ] || reply_error 'REDIR and TPROXY ports must differ'
    for reserved_port in 80 1080; do
      [ "$REDIR_PORT" != "$reserved_port" ] && [ "$TPROXY_PORT" != "$reserved_port" ] || reply_error 'Port is reserved by Xray RemnaSub'
    done
    case "$LOG_LEVEL" in none|debug|info|warning|error) ;; *) reply_error 'Invalid log level' ;; esac
    case "$NETWORK_QDISC" in system|fq_codel|cake|codel|sfq|pfifo|bfifo) ;; *) reply_error 'Invalid qdisc' ;; esac
    case "$NETWORK_DISABLE_IPV6" in 0|1) ;; *) NETWORK_DISABLE_IPV6=1 ;; esac
    case "$NETWORK_DISABLE_MULTICAST" in 0|1) ;; *) NETWORK_DISABLE_MULTICAST=1 ;; esac
    for timeout_value in "$NETWORK_CT_ESTABLISHED" "$NETWORK_CT_SYN_SENT" "$NETWORK_CT_SYN_RECV" "$NETWORK_CT_FIN_WAIT" "$NETWORK_CT_CLOSE_WAIT" "$NETWORK_CT_LAST_ACK" "$NETWORK_CT_TIME_WAIT" "$NETWORK_CT_CLOSE" "$NETWORK_CT_UNACKNOWLEDGED" "$NETWORK_CT_UDP_STREAM"; do
      valid_number "$timeout_value" && [ "$timeout_value" -ge 1 ] && [ "$timeout_value" -le 604800 ] || reply_error 'Conntrack timeouts must be 1..604800 seconds'
    done
    case "$XRAY_SNIFFING_ENABLED:$XRAY_SNIFFING_ROUTE_ONLY" in [01]:[01]) ;; *) reply_error 'Invalid sniffing settings' ;; esac
    case "$probe_url" in http://*|https://*) ;; *) reply_error 'Health check URL must use HTTP or HTTPS' ;; esac
    case "$probe_url" in *[[:space:]]*) reply_error 'Health check URL must not contain whitespace' ;; esac
    [ "${#probe_url}" -le 2048 ] || reply_error 'Health check URL is too long'
    valid_number "$XRAY_PROBE_TIMEOUT_SECONDS" && [ "$XRAY_PROBE_TIMEOUT_SECONDS" -ge 1 ] && [ "$XRAY_PROBE_TIMEOUT_SECONDS" -le 30 ] || reply_error 'Health check timeout must be 1..30 seconds'
    case "$XRAY_PROBE_HTTP_METHOD" in GET|HEAD) ;; *) reply_error 'Health check method must be GET or HEAD' ;; esac
    case "$GEODATA_STORAGE" in memory|persistent) ;; *) reply_error 'Invalid geodata storage mode' ;; esac
    # Вид панели приезжает в той же форме, но к рантайму отношения не имеет:
    # менять его перестройкой конфигурации и перезапуском Xray нельзя, поэтому
    # эти два поля намеренно не входят в runtime_signature ниже.
    ui_theme=$(form_value ui_theme); [ -z "$ui_theme" ] || UI_THEME=$ui_theme
    ui_accent=$(form_value ui_accent)
    if [ "$(form_value ui_accent_present)" = 1 ]; then
      if [ -z "$ui_accent" ]; then UI_ACCENT=; else UI_ACCENT=$ui_accent; fi
    fi
    valid_theme "$UI_THEME" || reply_error 'Invalid interface theme'
    [ -z "$UI_ACCENT" ] || valid_accent "$UI_ACCENT" || reply_error 'Accent colour must be #rrggbb'
    XRAY_PROBE_URL_B64=$(b64_encode "$probe_url")
    runtime_signature=$LISTENER_MODE:$REDIR_PORT:$TPROXY_PORT:$LOG_LEVEL:$XRAY_SNIFFING_ENABLED:$XRAY_SNIFFING_ROUTE_ONLY:$GEODATA_STORAGE:$XRAY_LOG_ERROR:$XRAY_LOG_ACCESS:$XRAY_LOG_DNS:$XRAY_LOG_MASK_ADDRESS
    write_state || reply_error 'Could not save container settings'
    network_settings_error=
    if ! apply_kernel_settings > "$RUNTIME_DIR/network-settings.log" 2>&1; then
      network_settings_error=$(tail -n 20 "$RUNTIME_DIR/network-settings.log" 2>/dev/null | tr '\r\n' '  ' | head -c 2048)
      [ -n "$network_settings_error" ] || network_settings_error='unknown error'
    fi
    for settings_profile in "$PROFILES_DIR"/p-*.conf; do
      [ -f "$settings_profile" ] || continue
      settings_id=${settings_profile##*/}; settings_id=${settings_id%.conf}
      if [ "$old_runtime_signature" != "$runtime_signature" ] && [ -s "$(profile_source "$settings_id")" ]; then
        queue_job "$settings_id" build || true
      fi
      if [ "$old_global_headers" != "$GLOBAL_HEADERS_B64" ] && [ -n "$(b64_decode "$(state_get "$settings_profile" URL_B64)")" ]; then
        queue_job "$settings_id" fetch || true
      fi
    done
    state_unlock
    [ -z "$network_settings_error" ] || reply_error "Could not apply Alpine network settings: $network_settings_error"
    json_headers; printf '{"ok":true}\n'
    ;;
  *) reply_error 'Unknown action' ;;
esac
