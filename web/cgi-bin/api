    selected_fingerprint=$(jq -r --argjson selected "$selected" '.[] | select(.index == $selected) | .fingerprint // empty' "$configs" 2>/dev/null | head -n1)
    if [ -z "$selected_fingerprint" ]; then
      unlock_job "$id-selection"
      reply_error 'Configuration not found'
    fi
