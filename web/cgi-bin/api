    cat > "$profile_tmp" <<EOF
PROFILE_VERSION=1
NAME_B64=$(b64_encode "$name")
URL_B64=
HEADERS_B64=
USE_PROFILE_HEADERS=1
SELECTED_INDEX=0
SELECTED_FINGERPRINT=
REFRESH_SECONDS=3600
TIMEOUT_SECONDS=30
INSECURE_TLS=0
USE_PROVIDER_TITLE=1
USE_PROVIDER_INTERVAL=1
EOF
    atomic_replace "$profile_tmp" "$PROFILES_DIR/$id.conf" || reply_error 'Could not create profile'
