#!/bin/sh
set -u
. /lib.sh

json_headers() { printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'; }
reply_error() { state_unlock; json_headers; jq -n --arg error "$1" '{ok:false,error:$error}'; exit 0; }
# Честный разбор percent-encoding. Прежний вариант превращал '%' в '\x' и
# скармливал строку printf '%b': браузер всё кодирует, но сырой обратный слэш
# из запроса, отправленного не браузером, интерпретировался как escape и молча
# портил значение. Здесь неполная или не-hex последовательность остаётся
# литеральным текстом, а '\' не значит ничего.
url_decode() {
  printf '%s' "${1:-}" | awk '
    BEGIN {
      for (i = 0; i < 16; i++) {
        digit[sprintf("%x", i)] = i
        digit[sprintf("%X", i)] = i
      }
    }
    {
      line = $0
      gsub(/\+/, " ", line)
      out = ""
      length_line = length(line)
      for (i = 1; i <= length_line; i++) {
        character = substr(line, i, 1)
        if (character == "%" && i + 2 <= length_line) {
          high = substr(line, i + 1, 1)
          low = substr(line, i + 2, 1)
          if ((high in digit) && (low in digit)) {
            code = digit[high] * 16 + digit[low]
            out = out (code == 0 ? "" : sprintf("%c", code))
            i += 2
            continue
          }
        }
        out = out character
      }
      printf "%s", out
    }
  '
}
query_value() { printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | awk -F= -v key="$1" '$1==key{sub(/^[^=]*=/,"");print;exit}'; }
form_value() { printf '%s' "$FORM_BODY" | tr '&' '\n' | awk -F= -v key="$1" '$1==key{sub(/^[^=]*=/,"");print;exit}' | { IFS= read -r value || true; url_decode "$value"; }; }

PROBE_TEMP_DIR=
PROBE_XRAY_PID=
PROBE_LOCK_PATH=
PROBE_ASSET_LEASE_DIR=
STATE_LOCKED=

state_lock() {
  [ -z "$STATE_LOCKED" ] || return 0
  lock_job global-state || return 1
  STATE_LOCKED=1
  trap 'state_unlock' EXIT
  trap 'state_unlock; exit 1' HUP INT TERM
}

state_unlock() {
  if [ "$STATE_LOCKED" = 1 ]; then
    unlock_job global-state
    STATE_LOCKED=
    trap - EXIT HUP INT TERM
  fi
}

probe_cleanup() {
  if [ -n "$PROBE_XRAY_PID" ] && kill -0 "$PROBE_XRAY_PID" 2>/dev/null; then
    kill -TERM "$PROBE_XRAY_PID" 2>/dev/null || true
    probe_stop_attempt=0
    while kill -0 "$PROBE_XRAY_PID" 2>/dev/null && [ "$probe_stop_attempt" -lt 10 ]; do
      probe_stop_attempt=$((probe_stop_attempt + 1))
      sleep 0.1
    done
    if kill -0 "$PROBE_XRAY_PID" 2>/dev/null; then
      kill -KILL "$PROBE_XRAY_PID" 2>/dev/null || true
    fi
  fi
  [ -z "$PROBE_XRAY_PID" ] || wait "$PROBE_XRAY_PID" 2>/dev/null || true
  if [ -n "$PROBE_ASSET_LEASE_DIR" ]; then
    /scripts/geodata.sh lease-release "$PROBE_ASSET_LEASE_DIR" "$$" >/dev/null 2>&1 || true
  fi
  case "$PROBE_TEMP_DIR" in "$RUNTIME_DIR"/probe.*) [ ! -e "$PROBE_TEMP_DIR" ] || rm -rf "$PROBE_TEMP_DIR" ;; esac
  if [ -n "$PROBE_LOCK_PATH" ] && [ "$(cat "$PROBE_LOCK_PATH/pid" 2>/dev/null || true)" = "$$" ]; then
    rm -f "$PROBE_LOCK_PATH/pid"
    rmdir "$PROBE_LOCK_PATH" 2>/dev/null || true
  fi
  PROBE_XRAY_PID=
  PROBE_TEMP_DIR=
  PROBE_LOCK_PATH=
  PROBE_ASSET_LEASE_DIR=
}

probe_lock() {
  PROBE_LOCK_PATH=$JOBS_DIR/probe.lock
  probe_lock_attempt=0
  probe_lock_ownerless_attempts=0
  while ! mkdir "$PROBE_LOCK_PATH" 2>/dev/null; do
    probe_lock_owner=$(cat "$PROBE_LOCK_PATH/pid" 2>/dev/null || true)
    if valid_number "$probe_lock_owner"; then
      probe_lock_ownerless_attempts=0
      if ! kill -0 "$probe_lock_owner" 2>/dev/null; then
        rm -f "$PROBE_LOCK_PATH/pid"
        rmdir "$PROBE_LOCK_PATH" 2>/dev/null || true
      fi
    else
      probe_lock_ownerless_attempts=$((probe_lock_ownerless_attempts + 1))
      if [ "$probe_lock_ownerless_attempts" -ge 50 ]; then
        probe_lock_owner=$(cat "$PROBE_LOCK_PATH/pid" 2>/dev/null || true)
        if ! valid_number "$probe_lock_owner"; then
          rm -f "$PROBE_LOCK_PATH/pid"
          rmdir "$PROBE_LOCK_PATH" 2>/dev/null || true
          probe_lock_ownerless_attempts=0
        fi
      fi
    fi
    probe_lock_attempt=$((probe_lock_attempt + 1))
    [ "$probe_lock_attempt" -lt 700 ] || return 1
    sleep 0.05
  done
  if ! printf '%s\n' "$$" > "$PROBE_LOCK_PATH/pid"; then
    rmdir "$PROBE_LOCK_PATH" 2>/dev/null || true
    PROBE_LOCK_PATH=
    return 1
  fi
}

probe_port() {
  probe_port_candidate=$((39000 + ($$ % 1000)))
  probe_port_attempt=0
  while [ "$probe_port_attempt" -lt 1000 ]; do
    if ! nc -z -w 1 127.0.0.1 "$probe_port_candidate" >/dev/null 2>&1; then
      printf '%s' "$probe_port_candidate"
      return 0
    fi
    probe_port_candidate=$((probe_port_candidate + 1))
    [ "$probe_port_candidate" -le 49999 ] || probe_port_candidate=39000
    probe_port_attempt=$((probe_port_attempt + 1))
  done
  return 1
}

require_post() {
  [ "${REQUEST_METHOD:-GET}" = POST ] || reply_error 'POST required'
  host=${HTTP_HOST:-} origin=${HTTP_ORIGIN:-} referer=${HTTP_REFERER:-}
  if [ -n "$origin" ]; then case "$origin" in "http://$host"|"https://$host") ;; *) reply_error 'Cross-origin request denied' ;; esac
  elif [ -n "$referer" ]; then case "$referer" in "http://$host/"*|"https://$host/"*) ;; *) reply_error 'Cross-origin request denied' ;; esac
  else reply_error 'Same-origin POST required'
  fi
  length=${CONTENT_LENGTH:-0}; valid_number "$length" || reply_error 'Invalid request length'
  [ "$length" -le 65536 ] || reply_error 'Request is too large'
  # head -c читает ровно столько байт, сколько обещал Content-Length, одним
  # заходом. dd bs=1 делал на то же самое до 65536 отдельных read().
  FORM_BODY=$(head -c "$length" 2>/dev/null)
}

profiles_json() {
  profiles_tmp=$RUNTIME_DIR/profiles.$$.jsonl
  : > "$profiles_tmp"
  for profile in "$PROFILES_DIR"/p-*.conf; do
    [ -f "$profile" ] || continue
    id=${profile##*/}; id=${id%.conf}
    meta=$(profile_meta "$id") status_file=$STATUS_DIR/$id.conf error=$ERRORS_DIR/$id.txt
    # Три запуска awk на профиль вместо тридцати семи: вебка опрашивает статус
    # раз в три секунды, и на роутере эти форки были заметной статьёй расхода.
    { read -r name_b64
      read -r url_b64
      read -r headers_b64
      read -r use_profile_headers
      read -r selected
      read -r selected_fingerprint
      read -r refresh
      read -r timeout
      read -r insecure
      read -r use_provider_title
      read -r use_provider_interval
    } <<EOF
$(state_load "$profile" NAME_B64 URL_B64 HEADERS_B64 USE_PROFILE_HEADERS SELECTED_INDEX SELECTED_FINGERPRINT \
  REFRESH_SECONDS TIMEOUT_SECONDS INSECURE_TLS USE_PROVIDER_TITLE USE_PROVIDER_INTERVAL)
EOF
    { read -r title_b64
      read -r interval_b64
      read -r fetched
      read -r meta_bytes
      read -r userinfo_b64
      read -r announce_b64
      read -r support_url_b64
      read -r web_page_url_b64
      read -r refill_b64
      read -r hwid_active_b64
      read -r hwid_unsupported_b64
      read -r hwid_max_b64
      read -r hwid_limit_b64
      read -r restriction_b64
      read -r policy_status
      read -r meta_http_status
      read -r meta_http_status_line_b64
    } <<EOF
$(state_load "$meta" TITLE_B64 INTERVAL_B64 FETCHED_EPOCH BYTES USERINFO_B64 ANNOUNCE_B64 SUPPORT_URL_B64 \
  WEB_PAGE_URL_B64 REFILL_B64 HWID_ACTIVE_B64 HWID_UNSUPPORTED_B64 HWID_MAX_B64 HWID_LIMIT_B64 \
  RESTRICTION_B64 POLICY_STATUS HTTP_STATUS HTTP_STATUS_LINE_B64)
EOF
    { read -r refresh_state
      read -r refresh_stage
      read -r refresh_action
      read -r started
      read -r finished
      read -r status_updated
      read -r response_bytes
      read -r status_message_b64
      read -r http_status
      read -r http_status_line_b64
      read -r validation_b64
    } <<EOF
$(state_load "$status_file" STATE STAGE ACTION STARTED_EPOCH FINISHED_EPOCH UPDATED BYTES MESSAGE_B64 \
  HTTP_STATUS HTTP_STATUS_LINE_B64 VALIDATION_B64)
EOF
    [ -n "$refresh_state" ] || refresh_state=idle
    [ -n "$refresh_stage" ] || refresh_stage=idle
    [ -n "$http_status" ] || http_status=$meta_http_status
    [ -n "$http_status_line_b64" ] || http_status_line_b64=$meta_http_status_line_b64
    [ -n "$response_bytes" ] || response_bytes=$meta_bytes
    [ -n "$validation_b64" ] || validation_b64=$(b64_encode "$(cat "$RUNTIME_DIR/$id.validation.log" 2>/dev/null || true)")
    valid_number "$selected" || selected=0
    valid_number "$refresh" || refresh=3600
    valid_number "$timeout" || timeout=30
    case "$insecure" in 0|1) ;; *) insecure=0 ;; esac
    case "$use_profile_headers" in 0|1) ;; *) use_profile_headers=1 ;; esac
    case "$use_provider_title" in 0|1) ;; *) use_provider_title=1 ;; esac
    case "$use_provider_interval" in 0|1) ;; *) use_provider_interval=1 ;; esac
    valid_number "$fetched" || fetched=0
    valid_number "$started" || started=0
    valid_number "$finished" || finished=0
    valid_number "$status_updated" || status_updated=0
    valid_number "$response_bytes" || response_bytes=0
    final_version=$(cat "$STATUS_DIR/$id.version" 2>/dev/null || printf 0); valid_number "$final_version" || final_version=0
    source_mtime=$(file_mtime "$(profile_source "$id")" 2>/dev/null || printf 0); valid_number "$source_mtime" || source_mtime=0
    final_mtime=$(file_mtime "$(profile_runtime "$id")" 2>/dev/null || printf 0); valid_number "$final_mtime" || final_mtime=0
    provider_refresh_seconds=0
    provider_interval=$(b64_decode "$interval_b64" | tr -d '\r\n ')
    valid_number "$provider_interval" && [ "$provider_interval" -ge 1 ] && [ "$provider_interval" -le 168 ] && provider_refresh_seconds=$((provider_interval * 3600))
    effective_refresh_seconds=$refresh
    [ "$use_provider_interval" = 0 ] || [ "$provider_refresh_seconds" -eq 0 ] || effective_refresh_seconds=$provider_refresh_seconds
    display_name_b64=$name_b64
    if [ "$use_provider_title" = 1 ]; then
      provider_title=$(b64_decode "$title_b64")
      case "$provider_title" in base64:*) provider_title=$(b64_decode "${provider_title#base64:}") ;; esac
      [ -z "$provider_title" ] || display_name_b64=$(b64_encode "$provider_title")
    fi
    source_file=$(profile_source "$id")
    source_present=false; [ -s "$source_file" ] && source_present=true
    source_empty=false
    if [ "$source_present" = true ] && jq -e 'type == "array" and length == 0' "$source_file" >/dev/null 2>&1; then source_empty=true; fi
    runtime_dir=$(profile_runtime_dir "$id")
    config_present=false
    [ -d "$runtime_dir" ] && [ -n "$(find "$runtime_dir" -maxdepth 1 -type f -name '*.json' -size +0c -print -quit 2>/dev/null)" ] && config_present=true
    using_previous_config=false; [ "$refresh_state" != error ] || [ "$config_present" = false ] || using_previous_config=true
    restricted=false
    [ -z "$restriction_b64$policy_status$hwid_unsupported_b64$hwid_max_b64$hwid_limit_b64" ] || restricted=true
    config_count=$(jq 'length' "$(profile_configs "$id")" 2>/dev/null || printf 0); valid_number "$config_count" || config_count=0
    fail_closed=false
    if [ "$config_present" = false ] && { [ "$restricted" = true ] || [ "$source_empty" = true ]; }; then fail_closed=true; fi
    error_b64=$(b64_encode "$(cat "$error" 2>/dev/null || true)")
    printf '%s\n' \
      "$id" "$name_b64" "$display_name_b64" "$url_b64" "$headers_b64" "$selected_fingerprint" \
      "$refresh_state" "$refresh_stage" "$refresh_action" "$status_message_b64" "$title_b64" "$interval_b64" \
      "$userinfo_b64" "$announce_b64" "$support_url_b64" "$web_page_url_b64" "$refill_b64" \
      "$hwid_active_b64" "$hwid_unsupported_b64" "$hwid_max_b64" "$hwid_limit_b64" \
      "$restriction_b64" "$policy_status" "$http_status" "$http_status_line_b64" "$validation_b64" "$error_b64" | \
    jq -Rsc \
      --argjson use_profile_headers "$use_profile_headers" \
      --argjson selected "$selected" \
      --argjson refresh "$refresh" --argjson provider_refresh "$provider_refresh_seconds" --argjson effective_refresh "$effective_refresh_seconds" \
      --argjson timeout "$timeout" --argjson insecure "$insecure" \
      --argjson use_provider_title "$use_provider_title" --argjson use_provider_interval "$use_provider_interval" \
      --argjson fetched "$fetched" --argjson started "$started" --argjson finished "$finished" --argjson status_updated "$status_updated" \
      --argjson response_bytes "$response_bytes" \
      --argjson source_present "$source_present" --argjson config_present "$config_present" --argjson using_previous "$using_previous_config" \
      --argjson restricted "$restricted" --argjson fail_closed "$fail_closed" --argjson config_count "$config_count" \
      --argjson source_mtime "$source_mtime" --argjson final_mtime "$final_mtime" --argjson final_version "$final_version" \
      'split("\n") as $s |
       {id:$s[0],name_b64:$s[1],display_name_b64:$s[2],url_b64:$s[3],headers_b64:$s[4],use_profile_headers:$use_profile_headers,selected_config_index:$selected,selected_config_fingerprint:$s[5],refresh_seconds:$refresh,provider_refresh_seconds:$provider_refresh,effective_refresh_seconds:$effective_refresh,timeout_seconds:$timeout,insecure_tls:$insecure,use_provider_title:$use_provider_title,use_provider_interval:$use_provider_interval,status:$s[6],refresh_state:$s[6],refresh_stage:$s[7],refresh_action:$s[8],status_message_b64:$s[9],fetched_at:$fetched,started_at:$started,finished_at:$finished,status_updated_at:$status_updated,title_b64:$s[10],interval_b64:$s[11],userinfo_b64:$s[12],announce_b64:$s[13],support_url_b64:$s[14],web_page_url_b64:$s[15],refill_b64:$s[16],hwid_active_b64:$s[17],hwid_unsupported_b64:$s[18],hwid_max_b64:$s[19],hwid_limit_b64:$s[20],restriction_b64:$s[21],policy_status:$s[22],http_status:$s[23],http_status_line_b64:$s[24],response_bytes:$response_bytes,validation_b64:$s[25],error_b64:$s[26],source_present:$source_present,config_present:$config_present,configuration_valid:$config_present,using_previous_config:$using_previous,restricted:$restricted,fail_closed:$fail_closed,config_count:$config_count,source_mtime:$source_mtime,final_mtime:$final_mtime,final_version:$final_version}' >> "$profiles_tmp"
  done
  jq -s . "$profiles_tmp"
  rm -f "$profiles_tmp"
}

status_response() {
  load_settings
  status_profiles=$RUNTIME_DIR/status-profiles.$$.json
  status_configs=$RUNTIME_DIR/status-configs.$$.json
  status_events=$RUNTIME_DIR/status-events.$$.txt
  if ! profiles_json > "$status_profiles"; then
    rm -f "$status_profiles" "$status_configs" "$status_events"
    reply_error 'Could not read profiles'
  fi
  active_configs=$(profile_configs "$ACTIVE_PROFILE_ID" 2>/dev/null || true)
  if [ -s "$active_configs" ]; then
    status_configs=$active_configs
  else
    printf '[]\n' > "$status_configs"
  fi
  status_probes=$RUNTIME_DIR/status-probes.$$.json
  if [ -s "$STATUS_DIR/$ACTIVE_PROFILE_ID.probes.json" ] &&
     jq -e 'type == "object"' "$STATUS_DIR/$ACTIVE_PROFILE_ID.probes.json" > /dev/null 2>&1; then
    cp "$STATUS_DIR/$ACTIVE_PROFILE_ID.probes.json" "$status_probes" 2>/dev/null || printf '{}\n' > "$status_probes"
  else
    printf '{}\n' > "$status_probes"
  fi
  tail -n 100 "$EVENT_LOG" > "$status_events" 2>/dev/null || : > "$status_events"
  running=false; xray_pid=$(cat "$RUNTIME_DIR/xray.pid" 2>/dev/null || true); valid_number "$xray_pid" && kill -0 "$xray_pid" 2>/dev/null && running=true
  # Версия ядра и доступность nftables определяются один раз при старте
  # контейнера: ни то, ни другое в рантайме не меняется, а раньше каждый опрос
  # статуса запускал ради них xray и nft.
  backend=$(cat "$RUNTIME_DIR/firewall.backend" 2>/dev/null || true)
  case "$backend" in nftables|iptables) ;; *) backend=iptables ;; esac
  xray_version=$(cat "$RUNTIME_DIR/xray.version" 2>/dev/null || true)
  active_interface=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1);exit}}')
  active_interface_cidr=; [ -z "$active_interface" ] || active_interface_cidr=$(ip -4 -o addr show dev "$active_interface" scope global 2>/dev/null | awk '{print $4;exit}')
  active_runtime_dir=$(profile_runtime_dir "$ACTIVE_PROFILE_ID" 2>/dev/null || true)
  effective_listener_mode=$LISTENER_MODE
  if [ -n "$active_runtime_dir" ]; then
    active_runtime_listener_mode=$(jq -r '.mode // empty' "$active_runtime_dir/.metadata/listener.json" 2>/dev/null || true)
    case "$active_runtime_listener_mode" in tproxy|redir-tproxy|redir-tun) effective_listener_mode=$active_runtime_listener_mode ;; esac
  fi
  xray_probe_url=$(b64_decode "$XRAY_PROBE_URL_B64")
  geodata_asset_dir=
  geodata_asset_count=0
  geodata_total_bytes=0
  geodata_last_update=0
  geodata_warning=
  geodata_metadata=$active_runtime_dir/.metadata/geodata.json
  if [ -s "$geodata_metadata" ]; then
    geodata_asset_dir=$(jq -r '.asset_dir // empty' "$geodata_metadata" 2>/dev/null || true)
    geodata_asset_count=$(jq -r '(.assets // []) | length' "$geodata_metadata" 2>/dev/null || printf 0)
    geodata_warning=$(jq -r '[.warnings[]? | ((.file // "geodata") + ": " + (.message // "update failed"))] | join("\n")' "$geodata_metadata" 2>/dev/null || true)
    # Размер и время берутся с самих файлов, а не из метаданных подготовки:
    # geodata обновляет Xray по своему расписанию, и записанные при сборке
    # значения устаревают в тот же момент, когда ядро скачало новую версию.
    #
    # Размер и время снимаются через wc и file_mtime, а не через stat: в
    # armv5-образе (Buildroot rootfs вместо Alpine) applet stat не собран, и
    # прямой вызов там просто ничего не вернул бы. file_mtime уже умеет
    # откатываться на date -r.
    if [ -n "$geodata_asset_dir" ]; then
      while IFS= read -r geodata_asset; do
        [ -n "$geodata_asset" ] || continue
        geodata_asset_path=$geodata_asset_dir/$geodata_asset
        [ -f "$geodata_asset_path" ] || continue
        geodata_size=$(wc -c < "$geodata_asset_path" 2>/dev/null || printf 0)
        valid_number "$geodata_size" || geodata_size=0
        geodata_total_bytes=$((geodata_total_bytes + geodata_size))
        geodata_mtime=$(file_mtime "$geodata_asset_path" 2>/dev/null || printf 0)
        valid_number "$geodata_mtime" || geodata_mtime=0
        [ "$geodata_mtime" -le "$geodata_last_update" ] || geodata_last_update=$geodata_mtime
      done <<EOF
$(jq -r '.assets[]?.file | select(type == "string")' "$geodata_metadata" 2>/dev/null || true)
EOF
    fi
  fi
  valid_number "$geodata_asset_count" || geodata_asset_count=0
  valid_number "$geodata_total_bytes" || geodata_total_bytes=0
  valid_number "$geodata_last_update" || geodata_last_update=0
  json_headers
  jq -n \
    --slurpfile profiles "$status_profiles" --slurpfile configs "$status_configs" --slurpfile probes "$status_probes" --rawfile events "$status_events" --arg active "$ACTIVE_PROFILE_ID" \
    --argjson run_enabled "$RUN_ENABLED" --argjson running "$running" --arg listener_mode "$LISTENER_MODE" \
    --argjson redir "$REDIR_PORT" --argjson tproxy "$TPROXY_PORT" --arg log_level "$LOG_LEVEL" \
    --arg xray_log_error "$XRAY_LOG_ERROR" --arg xray_log_access "$XRAY_LOG_ACCESS" \
    --argjson xray_log_dns "$XRAY_LOG_DNS" --argjson xray_log_mask_address "$XRAY_LOG_MASK_ADDRESS" \
    --arg global_headers_b64 "$GLOBAL_HEADERS_B64" \
    --arg network_qdisc "$NETWORK_QDISC" --argjson network_disable_ipv6 "$NETWORK_DISABLE_IPV6" --argjson network_disable_multicast "$NETWORK_DISABLE_MULTICAST" \
    --argjson network_ct_established "$NETWORK_CT_ESTABLISHED" --argjson network_ct_syn_sent "$NETWORK_CT_SYN_SENT" --argjson network_ct_syn_recv "$NETWORK_CT_SYN_RECV" \
    --argjson network_ct_fin_wait "$NETWORK_CT_FIN_WAIT" --argjson network_ct_close_wait "$NETWORK_CT_CLOSE_WAIT" --argjson network_ct_last_ack "$NETWORK_CT_LAST_ACK" \
    --argjson network_ct_time_wait "$NETWORK_CT_TIME_WAIT" --argjson network_ct_close "$NETWORK_CT_CLOSE" --argjson network_ct_unacknowledged "$NETWORK_CT_UNACKNOWLEDGED" --argjson network_ct_udp_stream "$NETWORK_CT_UDP_STREAM" \
    --argjson xray_sniffing_enabled "$XRAY_SNIFFING_ENABLED" --argjson xray_sniffing_route_only "$XRAY_SNIFFING_ROUTE_ONLY" \
    --arg xray_probe_url "$xray_probe_url" --argjson xray_probe_timeout_seconds "$XRAY_PROBE_TIMEOUT_SECONDS" --arg xray_probe_http_method "$XRAY_PROBE_HTTP_METHOD" \
    --arg geodata_storage "$GEODATA_STORAGE" --arg geodata_asset_dir "$geodata_asset_dir" --argjson geodata_asset_count "$geodata_asset_count" \
    --argjson geodata_total_bytes "$geodata_total_bytes" --argjson geodata_last_update "$geodata_last_update" --arg geodata_warning "$geodata_warning" \
    --arg backend "$backend" --arg active_interface "$active_interface" --arg active_interface_cidr "$active_interface_cidr" --arg effective_listener_mode "$effective_listener_mode" --arg version "$xray_version" \
    --arg ui_theme "$UI_THEME" --arg ui_accent "$UI_ACCENT" \
    '{ok:true,ui_theme:$ui_theme,ui_accent:$ui_accent,profiles:($profiles[0] // []),configs:($configs[0] // []),probes:($probes[0] // {}),active_profile_id:$active,run_enabled:$run_enabled,running:$running,listener_mode:$listener_mode,effective_listener_mode:$effective_listener_mode,redir_port:$redir,tproxy_port:$tproxy,log_level:$log_level,xray_log_error:$xray_log_error,xray_log_access:$xray_log_access,xray_log_dns:$xray_log_dns,xray_log_mask_address:$xray_log_mask_address,global_headers_b64:$global_headers_b64,network_qdisc:$network_qdisc,network_disable_ipv6:$network_disable_ipv6,network_disable_multicast:$network_disable_multicast,network_ct_established:$network_ct_established,network_ct_syn_sent:$network_ct_syn_sent,network_ct_syn_recv:$network_ct_syn_recv,network_ct_fin_wait:$network_ct_fin_wait,network_ct_close_wait:$network_ct_close_wait,network_ct_last_ack:$network_ct_last_ack,network_ct_time_wait:$network_ct_time_wait,network_ct_close:$network_ct_close,network_ct_unacknowledged:$network_ct_unacknowledged,network_ct_udp_stream:$network_ct_udp_stream,xray_sniffing_enabled:$xray_sniffing_enabled,xray_sniffing_route_only:$xray_sniffing_route_only,xray_probe_url:$xray_probe_url,xray_probe_timeout_seconds:$xray_probe_timeout_seconds,xray_probe_http_method:$xray_probe_http_method,geodata_storage:$geodata_storage,geodata_asset_dir:$geodata_asset_dir,geodata_asset_count:$geodata_asset_count,geodata_total_bytes:$geodata_total_bytes,geodata_last_update:$geodata_last_update,geodata_warning:$geodata_warning,firewall_backend:$backend,active_interface:$active_interface,active_interface_cidr:$active_interface_cidr,version:$version,events_b64:($events | @base64)}'
