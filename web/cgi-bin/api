    valid_number "$timeout" && [ "$timeout" -ge 3 ] && [ "$timeout" -le 120 ] || reply_error 'Timeout must be 3..120 seconds'
    case "$insecure" in 0|1) ;; *) insecure=0 ;; esac
    case "$use_profile_headers:$use_provider_title:$use_provider_interval" in [01]:[01]:[01]) ;; *) reply_error 'Invalid profile switches' ;; esac
    lock_job "$id-selection" || reply_error 'Could not lock profile configuration'
    if [ ! -f "$profile" ]; then
      unlock_job "$id-selection"
      reply_error 'Profile not found'
    fi
    old_fetch_signature="$(state_get "$profile" URL_B64)|$(state_get "$profile" HEADERS_B64)|$(state_get "$profile" USE_PROFILE_HEADERS 1)|$(state_get "$profile" TIMEOUT_SECONDS 30)|$(state_get "$profile" INSECURE_TLS 0)"
    selected=$(state_get "$profile" SELECTED_INDEX 0); valid_number "$selected" || selected=0
