      [((.observatory // {}) | to_entries[]) | select(.key | startswith($prefix)) | .value] as $results |
      [$results[] | select(.alive == true)] as $alive |
      {alive:($alive | length),delay_ms:([$alive[] | .delay | select(type == "number" and . >= 0)] | min // null)}
