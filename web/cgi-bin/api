      if wget -q -Y off -T 1 -O "$probe_metrics_tmp" "http://127.0.0.1:$probe_metrics_port/debug/vars" 2>/dev/null &&
         jq -e 'type == "object"' "$probe_metrics_tmp" >/dev/null 2>&1; then
