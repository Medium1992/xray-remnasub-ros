action=$(url_decode "$(query_value action)")
case "${REQUEST_METHOD:-GET}:$action" in
  GET:status|'GET:') status_response; exit 0 ;;
  GET:source|GET:config)
    id=$(url_decode "$(query_value profile_id)"); valid_profile_id "$id" || reply_error 'Invalid profile'
    [ "$action" = source ] && file=$(profile_source "$id") || file=$(profile_runtime "$id")
    printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
    [ -f "$file" ] && cat "$file" || printf 'null\n'
    exit 0
