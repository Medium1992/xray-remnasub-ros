URL_B64=$(b64_encode "$url")
HEADERS_B64=$(b64_encode "$headers")
USE_PROFILE_HEADERS=$use_profile_headers
SELECTED_INDEX=$selected
SELECTED_FINGERPRINT=$selected_fingerprint
REFRESH_SECONDS=$refresh
TIMEOUT_SECONDS=$timeout
INSECURE_TLS=$insecure
USE_PROVIDER_TITLE=$use_provider_title
USE_PROVIDER_INTERVAL=$use_provider_interval
EOF
