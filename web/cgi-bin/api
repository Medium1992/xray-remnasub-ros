  select-config)
    id=$(form_value profile_id); profile=$(profile_path "$id") || reply_error 'Invalid profile'; [ -f "$profile" ] || reply_error 'Profile not found'
    selected=$(form_value config_index); valid_number "$selected" || reply_error 'Invalid configuration'
    lock_job "$id-selection" || reply_error 'Could not lock profile selection'
    if [ ! -f "$profile" ]; then
      unlock_job "$id-selection"
      reply_error 'Profile not found'
    fi
