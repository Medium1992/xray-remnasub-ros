    case "$GEODATA_STORAGE:$probe_asset_dir" in
      memory:"$RUNTIME_DIR"/geodata/*|persistent:"$APP_DIR"/geodata/*) [ -d "$probe_asset_dir" ] || reply_error 'Geodata is not ready' ;;
