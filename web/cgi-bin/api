        # работает, а ждать отчёта от всех остальных — это ровно то время,
        # которое проверка и съедала. Если живых пока нет, ждём дальше, пока
        # не отчитаются все или не выйдет таймаут.
        probe_seen=$(jq -r --arg prefix "$probe_target_prefix" '((.observatory // {}) | to_entries | map(select(.key | startswith($prefix))) | length)' "$probe_metrics" 2>/dev/null)
        valid_number "$probe_seen" || probe_seen=0
