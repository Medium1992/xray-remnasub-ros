    use_profile_headers=$(form_value use_profile_headers); use_provider_title=$(form_value use_provider_title); use_provider_interval=$(form_value use_provider_interval)
    [ -n "$use_profile_headers" ] || use_profile_headers=$(state_get "$profile" USE_PROFILE_HEADERS 1)
    [ -n "$use_provider_title" ] || use_provider_title=$(state_get "$profile" USE_PROVIDER_TITLE 1)
    [ -n "$use_provider_interval" ] || use_provider_interval=$(state_get "$profile" USE_PROVIDER_INTERVAL 1)
    [ -n "$name" ] || reply_error 'Name is required'
    [ "$(printf '%s' "$name" | tr -d '\r\n')" = "$name" ] && [ "${#name}" -le 80 ] || reply_error 'Name must be one line and at most 80 characters'
    case "$url" in http://*|https://*) ;; *) reply_error 'URL must use HTTP or HTTPS' ;; esac
    [ "$(printf '%s' "$url" | tr -d '\r\n')" = "$url" ] && [ "${#url}" -le 4096 ] || reply_error 'URL must be one line and at most 4096 characters'
    valid_header_block "$headers" || reply_error 'Headers contain an invalid or duplicate name'
