      selectors($config.burstObservatory.subjectSelector) as $burst_selectors |
      selectors($config.observatory.subjectSelector) as $regular_selectors |
      (matching($outbounds; $burst_selectors) | unique_tags) as $burst_targets |
      (matching($outbounds; $regular_selectors) | unique_tags) as $regular_targets |
      if ($burst_targets | length) > 0 then
        (($config.burstObservatory.pingConfig.timeout // null) as $timeout |
         ($config.burstObservatory.pingConfig.httpMethod // $default_method | tostring | trim_space | ascii_upcase) as $method |
        {source:"burst",targets:$burst_targets,url:($config.burstObservatory.pingConfig.destination // $default_url),
         timeout:timeout_value($timeout; $default_timeout),wait_timeout:wait_seconds($timeout; $default_timeout),
         method:(if ($method | http_method) then $method else $default_method end)})
