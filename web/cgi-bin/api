    probe_expected_fingerprint=
    probe_source=$(profile_source "$id")
    probe_source_ready=0
    if lock_job "$id-selection"; then
      configs=$(profile_configs "$id" 2>/dev/null || true)
      probe_expected_fingerprint=$(jq -r --argjson selected "$probe_index" '.[] | select(.index == $selected) | .fingerprint // empty' "$configs" 2>/dev/null | head -n1)
