      --slurpfile plan "$probe_plan" \
      --arg target_prefix "$probe_target_prefix" \
      --arg metrics_tag "${probe_prefix}metrics" \
      --arg metrics_listen "127.0.0.1:$probe_metrics_port" \
      --arg url "$probe_url" \
      --arg method "$probe_method" \
      --arg timeout "$probe_timeout" \
      --arg asset_dir "$probe_asset_dir" '
